{
    "name": "Import album.link releases to MusicBrainz",
    "description": "Import album.link smart links with Harmony and add their remaining URL relationships to MusicBrainz.",
    "version": "2026.09.12.1",
    "author": "Raman Sinclair",
    "namespace": "https://github.com/murdos/musicbrainz-userscripts/",
    "downloadURL": "https://raw.githubusercontent.com/murdos/musicbrainz-userscripts/dist/albumlink_importer.user.js",
    "updateURL": "https://raw.githubusercontent.com/murdos/musicbrainz-userscripts/dist/albumlink_importer.user.js",
    "match": ["https://album.link/*", "https://*.album.link/*"],
    "grant": ["GM.getValue", "GM.setValue", "GM_getValue", "GM_setValue"],
    "runAt": "document-idle",
    "icon": "https://metabrainz.org/static/img/projects/musicbrainz.svg"
}
