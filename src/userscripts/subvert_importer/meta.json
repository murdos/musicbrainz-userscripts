    "downloadURL": "https://raw.githubusercontent.com/murdos/musicbrainz-userscripts/dist/subvert_importer.user.js",
    "updateURL": "https://raw.githubusercontent.com/murdos/musicbrainz-userscripts/dist/subvert_importer.user.js",
    "match": ["https://subvert.fm/*/*", "https://www.subvert.fm/*/*"],
    "icon": "https://metabrainz.org/static/img/projects/musicbrainz.svg"
}
